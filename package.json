{
  "name": "dodoumir",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/prisma && cp src/prisma/contract.json dist/prisma/contract.json",
